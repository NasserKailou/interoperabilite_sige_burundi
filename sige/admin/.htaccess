# ─── SIGE Burundi — Dossier Admin ─────────────────────────────────────────────
# Sert les fichiers PHP directement, redirige la racine admin/ vers login.php
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes

# Fichier d'index par défaut
DirectoryIndex login.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── 1. Fichiers et dossiers existants → servis directement ────────────
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 2. URLs propres : rewrite X → X.php si le fichier .php existe ─────
    # Ex: /admin/login → /admin/login.php
    # Ex: /admin/dashboard → /admin/dashboard.php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>
