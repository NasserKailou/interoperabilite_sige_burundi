# ─── SIGE Burundi — Racine du projet ──────────────────────────────────────────
# Redirection interne : http://.../sige/ → http://.../sige/public/index.php
# Compatible XAMPP + Apache 2.4 (mod_rewrite requis, AllowOverride All)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── 1. Ne pas rediriger si déjà dans /public/ ─────────────────────────
    RewriteCond %{REQUEST_URI} /public/ [NC]
    RewriteRule ^ - [L]

    # ── 2. Ne pas rediriger /admin/ ────────────────────────────────────────
    # sige/admin/ est un vrai dossier Apache, pas sous public/
    # Sans cette règle, /admin/ serait redirigé vers public/admin/ (inexistant)
    RewriteCond %{REQUEST_URI} /admin/ [NC]
    RewriteRule ^ - [L]

    # ── 3. Rediriger TOUT le reste vers public/ ────────────────────────────
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# ─── Fallback si mod_rewrite désactivé ────────────────────────────────────────
# Activer la ligne ci-dessous uniquement si mod_rewrite est absent :
# DirectoryIndex public/index.php
