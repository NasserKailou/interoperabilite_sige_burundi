# ─── SIGE Burundi — Dossier public/ ──────────────────────────────────────────
# Routage interne Apache pour le dossier public/
# Compatible XAMPP (AllowOverride All requis dans httpd.conf)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.php

# ─── En-têtes de sécurité ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ─── Cache des assets statiques ───────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── IMPORTANT : NE PAS définir RewriteBase ici ────────────────────────
    # Apache résout les chemins relativement à ce répertoire physique.
    # Définir RewriteBase / causerait des conflits en sous-dossier XAMPP.

    # ── 1. Fichiers et dossiers existants → servis directement ───────────
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 2. URLs propres : rewrite X → X.php si le fichier .php existe ────
    # Ex: /public/api/eleves → /public/api/eleves.php
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]

    # ── 3. Tout le reste → index.php (portail principal) ─────────────────
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# ─── Compression GZIP ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── Blocage des fichiers sensibles ───────────────────────────────────────────
# Protéger les fichiers qui ne doivent pas être servis directement
<FilesMatch "\.(sql|log|md|ini)$">
    Require all denied
</FilesMatch>
